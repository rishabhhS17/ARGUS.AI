# Copy to .env for local dev. On Render, set these in the dashboard (Environment tab).
# PORT is provided automatically by Render — do NOT set it there.

# Server
NODE_ENV=production
PORT=3001
# Reverse proxies in front of the server: 0 locally, 1 on Render. Makes rate limits per user IP.
TRUST_PROXY_HOPS=0

# MongoDB — use a cloud connection string (e.g. MongoDB Atlas), NOT localhost, on Render
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinel_db?retryWrites=true&w=majority

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Admin protected routes
ADMIN_KEY=your_secret_admin_key_here

# Correlation: how far apart (km) two reports may be and still count as the same event.
# EXACT: both name a specific place ("Gate 2, Sarojini market").
# AREA: either one only names a neighbourhood ("Sarojini Nagar").
MATCH_RADIUS_EXACT_KM=0.5
MATCH_RADIUS_AREA_KM=1.5
